{
  "manifest_version": 3,
  "name": "Video PiP Pro - Speed the Player",
  "version": "1.0.0",
  "description": "Custom PiP player: 3x speed, +/-5s skip, seek bar for reels/shorts/long videos + up/down scroll buttons for posts. Works on every site.",
  "browser_specific_settings": {
    "gecko": {
      "id": "video-pip-pro@trytotest.com",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Video PiP Pro settings",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "commands": {
    "vpp-scroll-down": {
      "suggested_key": { "default": "Alt+Down" },
      "description": "Scroll down / next post or reel"
    },
    "vpp-scroll-up": {
      "suggested_key": { "default": "Alt+Up" },
      "description": "Scroll up / previous post or reel"
    },
    "vpp-speed-cycle": {
      "suggested_key": { "default": "Alt+S" },
      "description": "Cycle playback speed up to 3x"
    },
    "vpp-pip": {
      "suggested_key": { "default": "Alt+P" },
      "description": "Open the PiP player for the current video or photo post"
    }
  }
}
